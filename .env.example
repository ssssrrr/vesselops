# 이 파일을 .env 로 복사한 뒤 값을 바꿔 사용한다. .env 는 저장소에 올리지 않는다.

# ---- Database ----
POSTGRES_DB=vesselops
POSTGRES_USER=vesselops
# 운영에서는 반드시 바꾼다. 최초 기동(빈 볼륨) 때의 값이 DB 에 고정된다.
POSTGRES_PASSWORD=change_me_in_production

# ---- Web ----
# 외부에 공개하는 유일한 포트
WEB_PORT=80

# ---- MQTT 브로커 ----
# 브로커(TLS 8883)를 여는 주소. 기본은 이 서버 안에서만 접속된다.
# 본선(sim-fleet·edge-gw)을 다른 장비로 떼어 낼 때만 0.0.0.0 으로 바꾼다.
MQTT_BIND=127.0.0.1
# 그때 브로커 인증서에 올릴 공개 주소. 예) DNS:mqtt.example.com,IP:203.0.113.10
PKI_BROKER_SAN=
# 인증서를 발급할 선박(IMO 번호, 공백 구분)
PKI_VESSELS=9876543 9876544 9812345 9754321

# ---- Edge 수집기 ----
# false: 시연 프로파일 (항상 1초 원본, 화면이 1초마다 갱신)
# true : 실선 프로파일 (평상시 1분 요약, 이상 징후 시 1초 원본 + 직전 10분 소급)
ADAPTIVE_ENABLED=false

# ---- 시뮬레이터 ----
# 평상시에도 알람 이력이 쌓이도록 가끔 경미한 이상을 자동 발생시킨다
SIM_AUTO_FAULT=true
